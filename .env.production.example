APP_ENV=production
LOG_LEVEL=INFO

STORAGE_BACKEND=postgres
# WARNING: POSTGRES_PASSWORD must be changed from change_me before deployment.
# DATABASE_URL password must match POSTGRES_PASSWORD.
DATABASE_URL=postgresql://project_a:change_me@postgres:5432/project_a
POSTGRES_DB=project_a
POSTGRES_USER=project_a
POSTGRES_PASSWORD=change_me

VECTOR_BACKEND=milvus
MILVUS_URI=http://milvus:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=project_a_v1

CACHE_ENABLED=true
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=1800

GRAPH_RETRIEVAL_ENABLED=false
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

AUTH_ENABLED=true
# WARNING: API Keys must be injected via environment variables, never hardcode.
VIEWER_API_KEY=<change-me>
OPERATOR_API_KEY=<change-me>
ADMIN_API_KEY=<change-me>

CORS_ALLOW_ORIGINS=<your-frontend-origin>
UPLOAD_MAX_BYTES=10485760

LLM_PROVIDER=<your-provider>
LLM_MODEL=<your-model>
LLM_API_KEY=<your-key>
LLM_BASE_URL=<your-base-url>

MULTIMODAL_BACKEND=sidecar
MINERU_COMMAND=mineru
MINERU_OUTPUT_DIR=/app/data/mineru_output
VISION_LLM_MODEL=
VISION_LLM_API_KEY=
VISION_LLM_BASE_URL=

# Job execution - production uses external worker
JOB_EXECUTION_MODE=worker
JOB_POLL_INTERVAL_SECONDS=5
JOB_DEFAULT_TIMEOUT_SECONDS=300

# Rate limiting - enabled in production
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_REDIS_URL=redis://redis:6379/0
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=30
RATE_LIMIT_EXEMPT_PATHS=/healthz,/readyz,/health,/metrics

# Metrics - enabled in production
METRICS_ENABLED=true
