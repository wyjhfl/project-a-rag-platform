# LLM provider: Xiaomi MiMo OpenAI-compatible endpoint
LLM_PROVIDER=xiaomi_mimo
LLM_MODEL=<your-mimo-model>
LLM_API_KEY=<your-mimo-api-key>
LLM_BASE_URL=<your-mimo-openai-compatible-base-url>

# Optional provider acceptance candidates for A-v1.4
# MiMo text models can reuse the same DashScope-compatible key.
# Example models: MiMo-V2.5-Pro, MiMo-V2.5
DEEPSEEK_API_KEY=

# Embedding provider
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# Structured storage
STORAGE_BACKEND=sqlite
APP_DATABASE_PATH=./data/app.db
DATABASE_URL=
CHROMA_PERSIST_DIR=./data/chroma
VECTOR_BACKEND=chroma
MILVUS_URI=
MILVUS_TOKEN=
MILVUS_COLLECTION=project_a_v1
REAL_DOCS_DIR=./data/real_manuals_sanitized
UPLOADED_DOCS_DIR=./data/uploaded_docs

# Required for PostgreSQL mode
# STORAGE_BACKEND=postgres
# DATABASE_URL=postgresql://project_a:project_a_dev@localhost:5432/project_a

# Required for Milvus mode
# VECTOR_BACKEND=milvus
# MILVUS_URI=http://localhost:19530
# MILVUS_COLLECTION=project_a_v1

# Required for real multimodal parsing
MULTIMODAL_BACKEND=sidecar
MINERU_COMMAND=mineru
MINERU_OUTPUT_DIR=./data/mineru_output
VISION_LLM_MODEL=
VISION_LLM_API_KEY=
VISION_LLM_BASE_URL=

# Optional graph retrieval
GRAPH_RETRIEVAL_ENABLED=false
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<your-neo4j-password>
NEO4J_DATABASE=neo4j

# Required for Redis cache mode
CACHE_ENABLED=false
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=1800

# Runtime
APP_ENV=development
LOG_LEVEL=INFO
