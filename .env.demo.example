# Project A public demo profile
# This file is safe to commit because it contains no secrets.
# Keep your real secrets in `.env`, especially `DEEPSEEK_API_KEY`.

APP_ENV=development
LOG_LEVEL=INFO

# Public demo chain
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Local storage/runtime
STORAGE_BACKEND=sqlite
APP_DATABASE_PATH=./data/app.demo.db
VECTOR_BACKEND=chroma
CHROMA_PERSIST_DIR=./data/chroma_demo
REAL_DOCS_DIR=./data/real_manuals_sanitized
UPLOADED_DOCS_DIR=./data/uploaded_docs

# Keep enterprise extras off for public demo
CACHE_ENABLED=false
GRAPH_RETRIEVAL_ENABLED=false
MULTIMODAL_BACKEND=sidecar

# Local demo ports
DEMO_BACKEND_HOST=127.0.0.1
DEMO_BACKEND_PORT=18082
DEMO_FRONTEND_HOST=127.0.0.1
DEMO_FRONTEND_PORT=4175
